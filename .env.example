# Copy this file to .env before running `docker compose up`.
# These credentials are for an isolated local-development database only.
POSTGRES_DB=mercury
POSTGRES_USER=mercury
POSTGRES_PASSWORD=mercury-local-password

# Compose services reach PostgreSQL by its service name and container port.
MERCURY_DATABASE_URL=postgres://mercury:mercury-local-password@postgres:5432/mercury?sslmode=disable

# Runtime role: all, api, scheduler, or worker.
MERCURY_ROLE=all

# Expired-lease recovery settings used by all and scheduler roles.
MERCURY_RECOVERY_INTERVAL=1m
MERCURY_RECOVERY_BATCH_SIZE=100

# HTTP settings used by all and api roles.
MERCURY_HTTP_LISTEN_ADDRESS=:8080
MERCURY_HTTP_READ_TIMEOUT=10s
MERCURY_HTTP_READ_HEADER_TIMEOUT=5s
MERCURY_HTTP_WRITE_TIMEOUT=30s
MERCURY_HTTP_IDLE_TIMEOUT=1m
MERCURY_HTTP_SHUTDOWN_TIMEOUT=10s

# Worker settings used by all and worker roles. Keep the ID unique per replica.
MERCURY_WORKER_ID=mercury-compose-worker-1
MERCURY_WORKER_CONCURRENCY=4
MERCURY_WORKER_POLL_INTERVAL=1s
MERCURY_WORKER_LEASE_DURATION=25h
MERCURY_WORKER_HEARTBEAT_INTERVAL=8h
